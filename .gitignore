# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Environment variables — real secrets never get committed.
# .env.local.example files ARE meant to be committed as templates and
# are not matched by any of the patterns below (they don't end in
# ".local", ".production", etc.) — double-check that stays true if you
# add new env filenames.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.development

# Vercel
.vercel

# Turborepo (harmless to keep even if you don't adopt it)
.turbo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Testing / coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.pem