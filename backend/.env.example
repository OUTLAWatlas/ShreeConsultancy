# Postgres connection string, e.g. from Supabase, Neon, or a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/shree_consultancy"

PORT=4000

# Shared secret admin-dashboard's Next.js server sends as x-api-key on
# every request. Generate with: openssl rand -hex 32
# Never exposed to the browser — this is a server-to-server secret only.
BACKEND_API_KEY=

# Shared secret the tender-scraper and dunning services send as
# x-automation-token. Generate with: openssl rand -hex 32
# Deliberately separate from BACKEND_API_KEY so the two can be rotated
# independently.
AUTOMATION_TOKEN=

# Origin allowed to POST to /leads (the public marketing site), e.g.
# https://shreeconsultancy.com. Required — /leads has no other auth.
PUBLIC_SITE_URL=http://localhost:3000

# Resend — the only place an email-sending secret lives. Both the
# dispatch button and the dunning reminders route through it.
RESEND_API_KEY=
EMAIL_FROM="Shree Consultancy <billing@shreeconsultancy.com>"

# S3-compatible object storage. Works unchanged with AWS S3 or Cloudflare
# R2 (same API) — only the endpoint and region differ.
#
# OPTIONAL: leave these blank and everything else still works. PDFs still
# generate and download in the browser, email still sends. Only CAD
# uploads, persisting generated PDFs, and attaching a stored file to an
# email need these, and each fails with a clear message until they're set.
#
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and STORAGE_REGION=auto
# AWS S3: leave STORAGE_ENDPOINT blank and set STORAGE_REGION to the bucket's region
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
