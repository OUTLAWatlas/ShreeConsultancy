# URL of the separate admin-dashboard deployment.
# The triple-click-logo easter egg redirects here — it never bundles
# any admin code into this app.
NEXT_PUBLIC_ADMIN_URL=https://admin.shreeconsultancy.com

# URL of the standalone backend service. The intake form POSTs leads to
# `${NEXT_PUBLIC_API_URL}/leads` directly — it does not route through
# admin-dashboard. The backend's CORS is scoped to this site's origin via
# its own PUBLIC_SITE_URL, so these two settings must agree.
NEXT_PUBLIC_API_URL=https://api.shreeconsultancy.com

# This site's own public URL — used for Open Graph / canonical metadata.
NEXT_PUBLIC_SITE_URL=https://shreeconsultancy.com
